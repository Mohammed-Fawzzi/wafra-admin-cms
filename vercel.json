{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/wafra-admin-cms.html" }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/wafra-admin-cms.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(index.html|wafra-admin-cms.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
